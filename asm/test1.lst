                      00746 ; ===========================================================
                      00747 ;   MUL10_24
                      00748 ;   Multiplies 24-bit accumulator MULX:MULH:MULL by 10.
                      00749 ;   Method: 10*X = 8*X + 2*X
                      00750 ;     1. Shift left once  -> 2*X (save in TMP3:TMPH:TMPL)
                      00751 ;     2. Shift left twice -> 8*X
                      00752 ;     3. Add back 2*X
                      00753 ;   Max input before final digit add: ~19999 = 0x04E1F  (safe in 3 bytes)
                      00754 ; ===========================================================
0218                  00755 MUL10_24
                      00756     ; Step 1: shift left 1 to get 2*X
0218   1003           00757     BCF     STATUS,C
0219   0DF2           00758     RLF     MULL,F
021A   0DF1           00759     RLF     MULH,F
021B   0DF0           00760     RLF     MULX,F
                      00761     ; Save 2*X into TMP3:TMPH:TMPL
021C   0870           00762     MOVF    MULX,W
021D   00EF           00763     MOVWF   TMP3
021E   0871           00764     MOVF    MULH,W
021F   00EB           00765     MOVWF   TMPH
0220   0872           00766     MOVF    MULL,W
0221   00EC           00767     MOVWF   TMPL
                      00768     ; Step 2: shift left 2 more to get 8*X
0222   1003           00769     BCF     STATUS,C
0223   0DF2           00770     RLF     MULL,F
0224   0DF1           00771     RLF     MULH,F
0225   0DF0           00772     RLF     MULX,F
0226   1003           00773     BCF     STATUS,C
0227   0DF2           00774     RLF     MULL,F
0228   0DF1           00775     RLF     MULH,F
0229   0DF0           00776     RLF     MULX,F
                      00777     ; Step 3: add 2*X back (MULX:MULH:MULL += TMP3:TMPH:TMPL)
