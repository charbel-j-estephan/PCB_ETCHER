                      00793 ;   BRESENHAM
                      00794 ;   2D line algorithm. Dominant axis always steps once per
                      00795 ;   iteration. Minor axis steps when accumulated error
                      00796 ;   exceeds the dominant delta.
                      00797 ;
                      00798 ;   All arithmetic is 24-bit to handle up to 100000 steps.
                      00799 ;
                      00800 ;   XDIR_F = 1: X moving toward home (negative direction)
                      00801 ;   YDIR_F = 1: Y moving toward home (negative direction)
                      00802 ;   DOM_FLAG = 0: X dominant | DOM_FLAG = 1: Y dominant
                      00803 ;
                      00804 ;   [v10-FIX-8] 16-bit BERR >= DELTA comparisons correctly
                      00805 ;   propagate borrow � extended to 24-bit in v11.
                      00806 ;
                      00807 ;   [v10-FIX-9] DX and DY direction subtractions correctly
                      00808 ;   propagate borrow � extended to 24-bit in v11.
                      00809 ; ===========================================================
