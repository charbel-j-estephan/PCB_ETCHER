0100   0008           00382     RETURN
                      00383 ; ===========================================================
                      00384 ;   DISP_DIGITS
                      00385 ;   Converts 24-bit step count in MULX:MULH:MULL to mm with
                      00386 ;   1 decimal place and outputs 5 LCD chars: "NNN.N"
                      00387 ;   (e.g. 80000 steps / 400 steps/mm = 200.0 -> "200.0")
                      00388 ;   Strategy: repeated subtraction of 40000 / 4000 / 400 / 40.
                      00389 ;   Save/restore on underflow so the remainder is always correct.
                      00390 ;   Clobbers: REG1, REG2, REG3, TMPH, TMPL, TMP2H, TMP2L, TMP3
                      00391 ;   MULX:MULH:MULL is consumed (left as remainder mod 40).
                      00392 ; ===========================================================
0101                  00393 DISP_DIGITS
                      00394     ; --- Hundreds of mm: subtract 40000 = 0x009C40 ---
0101   01A1           00395     CLRF    REG1
0102                  00396 DD_H_LOOP
0102   0870           00397     MOVF    MULX,W
0103   00EF           00398     MOVWF   TMP3            ; save HI
0104   0871           00399     MOVF    MULH,W
0105   00EB           00400     MOVWF   TMPH            ; save MD
0106   0872           00401     MOVF    MULL,W
0107   00EC           00402     MOVWF   TMPL            ; save LO
0108   3040           00403     MOVLW   0x40
0109   02F2           00404     SUBWF   MULL,F          ; MULL -= 0x40; C=0 -> borrow
010A   309C           00405     MOVLW   0x9C
010B   1C03           00406     BTFSS   STATUS,C
MPASM  5.50                         TEST1.ASM   4-14-2026  7:44:24         PAGE  9


