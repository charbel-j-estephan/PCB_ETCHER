010E   3000           00409     MOVLW   0x00
010F   1C03           00410     BTFSS   STATUS,C
0110   3E01           00411     ADDLW   1               ; add borrow: subtract 1 from MULX
0111   02F0           00412     SUBWF   MULX,F          ; C=0 -> overall underflow
0112   1C03           00413     BTFSS   STATUS,C
0113   2916           00414     GOTO    DD_H_RESTORE
