secrets.h
*.secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# ---- Python ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

